# Copy to .env and fill in. Only CLAUDE_CODE_OAUTH_TOKEN is required.

# Claude login for the container. Create it on the host with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Personality
PET_NAME=Jarvis
PET_USER_NAME=
# What you say to wake it, if that differs from the name (e.g. PET_NAME=Ben with the hey_jarvis model below)
PET_WAKE_PHRASE=Hey Jarvis
# Wake word: the openWakeWord model in the voice container listens for it. Changing it needs a model for the
# new phrase (pre-trained: hey_jarvis, alexa, hey_mycroft, hey_rhasspy) and: docker compose build voice
WAKE_MODEL=hey_jarvis
# 0 to 1. Raise it if the pet wakes when nobody called it; lower it if it misses you.
WAKE_THRESHOLD=0.5
# Spellings the speech recogniser may produce for the name, used to remove "Hey <name>" from the start of a request.
PET_WAKE_WORDS=jarvis,javis,jervis,jarvus,jarves,jarvice,jarbis

# Behaviour
TZ=Asia/Kolkata
PET_BRIEFING=1
PET_BRIEFING_TIME=09:00
PET_QUIET_START=22:00
PET_QUIET_END=08:00
PET_NUDGE_LEAD_MINUTES=30
PET_MEETING_LEAD_MINUTES=10
# Working hours (Monday to Friday): used for free time, the wrap-up and break reminders
PET_WORK_START=09:30
PET_WORK_END=18:30
PET_WRAPUP=on
PET_WRAPUP_TIME=18:00
# After a meeting ends, offer to take notes; stay quiet during meetings on the calendar
PET_MEETING_FOLLOWUP=on
PET_MEETING_QUIET=on
# Suggest a stretch break after this many minutes at the keyboard (0 = off)
PET_BREAK_EVERY_MINUTES=0
# Remind you to drink water this often while you are at the PC (0 = off)
PET_WATER_EVERY_MINUTES=60
# During focus time, set the Teams status to Do not disturb (needs the Microsoft sign-in): on or off
PET_FOCUS_TEAMS_DND=on
PET_STALE_TASK_DAYS=14
PET_DAILY_TURN_LIMIT=200
PET_SESSION_IDLE_MINUTES=30

# Claude model (empty = the Claude CLI default) and reasoning effort (low is fastest for voice)
PET_MODEL=
PET_EFFORT=low

# Microsoft To Do and OneNote (optional). Client id of an Entra app registration; see the README.
# Leave MS_TENANT_ID empty for any work account, or set your tenant id / domain.
MS_CLIENT_ID=
MS_TENANT_ID=

# Port on 127.0.0.1 that the pet client and the chat page use
PET_PORT=47821

# Voice models, baked into the voice image at build time (rebuild after changing)
STT_MODEL=small.en
TTS_VOICE=en_US-amy-medium
VOICE_THREADS=6

# Keyboard shortcuts (Electron accelerator format). Ctrl+Alt+Space is taken by the Claude app's quick entry.
PET_HOTKEY_TALK=Control+Alt+B
PET_HOTKEY_DISMISS=Control+Alt+X
PET_HOTKEY_PAUSE=Control+Alt+P
PET_HOTKEY_DICTATE=Control+Alt+D
PET_HOTKEY_SUMMARISE=Control+Alt+S
PET_HOTKEY_REPHRASE=Control+Alt+R

# OneNote notebook for new notes and the work log: its name, or part of its OneDrive path when two notebooks
# share a name (e.g. Notebooks/My Notebook). Empty: OneNote's own Quick Notes location. Restart the pet after changing.
PET_ONENOTE_NOTEBOOK=
# Section in that notebook for new notes that fit no existing section (made if missing).
PET_ONENOTE_SECTION=Quick Notes
# Work log: the section, the monthly page title (strftime) and, optionally, a yearly page the month pages sit under.
# Example for "Nov, 2026" as a sub-page of "2026" in "Daily Progress": Daily Progress / %b, %Y / %Y
PET_WORKLOG_SECTION=Work Log
PET_WORKLOG_PAGE=Work log - %B %Y
PET_WORKLOG_YEAR_PAGE=
